{
  "name": "mcquiz",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "db:start": "supabase start -x realtime,storage-api,imgproxy,edge-runtime,logflare,vector,supavisor",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "icons": "node scripts/make-icons.mjs",
    "test:int": "vitest run --project int",
    "test:all": "vitest run",
    "db:types": "supabase gen types typescript --local --schema public,access,catalog,learning,knowledge,community > src/shared/db/database.types.ts",
    "cli": "tsx scripts/cli.ts",
    "sources:add": "tsx scripts/cli.ts sources add",
    "sources:embed": "tsx scripts/cli.ts sources embed",
    "questions:add": "tsx scripts/cli.ts questions add"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "mcp-handler": "^2.4.0",
    "next": "16.4.5",
    "openai": "^7.53.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "eslint-plugin-boundaries": "^7.4.5",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
